/// Product dimension organizing Microsoft data platform products. Contains five columns (Organization > Pillar > Product Group > Product Mid Group > Product); the Copilot-exposed Product Hierarchy uses the bottom three levels (Product Group > Product Mid Group > Product).
table 'Product Master'

	column 'Custom Product'
		dataType: string
		sourceColumn: CustomProduct

	column CustomProductGroupSort
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: CustomProductGroupSort

	/// DIM_ProductMasterId
	column DIM_ProductMasterId
		dataType: int64
		isHidden
		isUnique
		isKey
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: DIM_ProductMasterId

	/// Organization (i.e. Azure Data)
	column Organization
		dataType: string
		sourceColumn: Organization

		annotation Copilot_Visibility = Visible

		annotation Copilot_Sliceable = true

		annotation Copilot_Enumerable = true

	/// Pillar (Intelligence Platform, Database Platform etc.)
	column Pillar
		dataType: string
		sourceColumn: Pillar

		annotation Copilot_Visibility = Visible

		annotation Copilot_Sliceable = true

		annotation Copilot_Enumerable = true

	column 'Product Group Sorted'
		dataType: string
		isHidden
		sourceColumn: ProductGroup
		sortByColumn: CustomProductGroupSort

		annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["UNNECESSARY_COLUMNS"]}

	/// Product Group (Business Intelligence, Data Integration, etc.)
	column 'Product Group'
		dataType: string
		sourceColumn: ProductGroup

		annotation Copilot_Visibility = Visible

		annotation Copilot_Sliceable = true

		annotation Copilot_Enumerable = true

		annotation Copilot_Synonyms

	/// Product Mid Group (Power BI, Data Factory, Data Explorer, etc.)
	column 'Product Mid Group'
		dataType: string
		sourceColumn: ProductMidGroup

		annotation Copilot_Visibility = Visible

		annotation Copilot_Sliceable = true

		annotation Copilot_Enumerable = true

		annotation Copilot_Synonyms

	/// Product Name (Power BI Embedded, Cognitive Services, Log Analytics, etc.)
	column Product
		dataType: string
		sourceColumn: Product

		annotation Copilot_Visibility = Visible

		annotation Copilot_Sliceable = true

		annotation Copilot_Enumerable = true

		annotation Copilot_Synonyms

		annotation Copilot_ValueSynonyms = DE and DS=DEDS;Data Engineering and Data Science|Real Time Intelligence=RTI|Data Integration=DI|Data Warehousing Core=DW Core|SQL Database=SQL DB|One Lake=OneLake|Power BI Backend=PBI Backend|Fabric Core=Fabric MAU

	/// Three-level product hierarchy: Product Group > Product Mid Group > Product. Organization and Pillar columns remain on the table but are excluded from the Copilot hierarchy (too coarse for typical Copilot queries).
	hierarchy 'Product Hierarchy'

		level 'Product Group'
			column: 'Product Group'

		level 'Product Mid Group'
			column: 'Product Mid Group'

		level Product
			column: Product

			annotation Copilot_Visibility = Hidden

			annotation Copilot_Synonyms

		annotation Copilot_SearchLadder = true

	partition 'Product Master' = entity
		mode: directLake
		source
			entityName: DIM_ProductMaster
			schemaName: Tabular_PartnerCommunity
			expressionSource: exp_directlake

	extendedProperty SourceColumn = Azure Data Insights and Analytics

	annotation TabularEditor_TableGroup = Dim

