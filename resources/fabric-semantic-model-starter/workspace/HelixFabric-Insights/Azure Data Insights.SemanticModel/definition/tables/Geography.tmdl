/// Geographic dimension representing the Microsoft subsidiary hierarchy (Big Area > Area > Region > Sub Region > Subsidiary > Subsidiary Region > Subsidiary District > Subsidiary Sub District). One row per Subsidiary Sub District.
table Geography

	/// Second level in the geographic hierarchy, below Big Area (e.g., North Europe, South Europe, ASEAN, Greater China, Latam).
	column Area
		dataType: string
		sourceColumn: Area

		annotation Copilot_Visibility = Visible

		annotation Copilot_Sliceable = true

		annotation Copilot_Enumerable = true

		annotation Copilot_Synonyms

	/// Top-level geographic grouping (e.g., Americas, Asia, EMEA, CorpHQ).
	column 'Big Area'
		dataType: string
		sourceColumn: BigArea

		annotation Copilot_Visibility = Visible

		annotation Copilot_Synonyms

		annotation Copilot_Sliceable = true

		annotation Copilot_Enumerable = true

	/// Surrogate key for the Geography dimension. Each row has a unique ID; the Subsidiary Sub District name alone is not globally unique — the same label appears across multiple subsidiaries.
	column DIM_SubsidiarySubDistrictId
		dataType: int64
		isHidden
		isUnique
		isKey
		isAvailableInMdx: false
		summarizeBy: none
		sourceColumn: DIM_SubsidiarySubDistrictId

	/// Third level in the geographic hierarchy, below Big Area and Area (e.g., Belgium, North MCC, GCR excl China, United States).
	column Region
		dataType: string
		sourceColumn: Region

		annotation Copilot_Visibility = Visible

		annotation Copilot_Synonyms

		annotation Copilot_Sliceable = true

		annotation Copilot_Enumerable = true

	/// Fourth level in the geographic hierarchy, below Region (e.g., Canada, Indonesia, CCA, Belgium).
	column 'Sub Region'
		dataType: string
		sourceColumn: SubRegion

		annotation Copilot_Visibility = Visible

		annotation Copilot_Synonyms

		annotation Copilot_Sliceable = true

		annotation Copilot_Enumerable = true

	/// Microsoft subsidiary representing the local Microsoft office responsible for a geography. May cover a single country or a multi-country cluster.
	column Subsidiary
		dataType: string
		sourceColumn: Subsidiary

		annotation Copilot_Visibility = Visible

		annotation Copilot_Synonyms

		annotation Copilot_Sliceable = true

		annotation Copilot_Enumerable = true

	partition Geography = entity
		mode: directLake
		source
			entityName: DIM_Geography
			schemaName: Tabular_AzureDataInsights
			expressionSource: exp_directlake

	extendedProperty SourceColumn = Upstream Finance Source

	annotation TabularEditor_TableGroup = Dim

