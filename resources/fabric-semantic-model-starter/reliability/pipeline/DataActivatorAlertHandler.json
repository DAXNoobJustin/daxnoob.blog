          "retry": 1,
          "retryIntervalInSeconds": 30,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "FabricSqlDatabaseSource",
            "sqlReaderQuery": {
              "value": "IF '@{trim(pipeline().parameters.AlertType)}' <> 'PerformanceDegradation' EXEC [dbo].[ClaimAlertSlot] @ItemId = '@{trim(pipeline().parameters.ItemId)}', @ItemName = '@{trim(pipeline().parameters.ItemName)}', @AlertType = '@{trim(pipeline().parameters.AlertType)}', @ActionType = 'Incident', @CooldownMinutes = @{json(string(pipeline().parameters.CooldownConfig))[trim(pipeline().parameters.AlertType)]} ELSE SELECT 0 AS Claimed",
