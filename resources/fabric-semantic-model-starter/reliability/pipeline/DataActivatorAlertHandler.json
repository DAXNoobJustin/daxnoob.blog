                  "artifactId": "@pipeline().parameters.AlertingDbArtifactId"
                },
                "externalReferences": {
                  "connection": "aaaaaaaa-aaaa-aaaa-aaaa-0000000000c4"
                }
              }
            },
            "type": "FabricSqlDatabaseTable",
            "schema": []
          }
