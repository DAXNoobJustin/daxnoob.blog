/// Hidden calculated table exposing model measure metadata via INFO.VIEW.MEASURES(). Used by ADIA skills for runtime registry loading.
table _INFO_MEASURES
	isHidden

	column ID
		isNameInferred
		sourceColumn: [ID]

	column Name
		isNameInferred
		sourceColumn: [Name]

	column Table
		isNameInferred
		sourceColumn: [Table]

	column Description
		isNameInferred
		sourceColumn: [Description]

	column DataType
		isNameInferred
		sourceColumn: [DataType]

	column Expression
		isNameInferred
		sourceColumn: [Expression]

	column FormatString
		isNameInferred
		sourceColumn: [FormatString]

	column IsHidden
		isNameInferred
		sourceColumn: [IsHidden]

	column State
		isNameInferred
		sourceColumn: [State]

	column KPIID
		isNameInferred
		sourceColumn: [KPIID]

	column IsSimpleMeasure
		isNameInferred
		sourceColumn: [IsSimpleMeasure]

	column DisplayFolder
		isNameInferred
		sourceColumn: [DisplayFolder]

	column DetailRowsDefinition
		isNameInferred
		sourceColumn: [DetailRowsDefinition]

	column DataCategory
		isNameInferred
		sourceColumn: [DataCategory]

	column FormatStringDefinition
		isNameInferred
		sourceColumn: [FormatStringDefinition]

	column LineageTag
		isNameInferred
		sourceColumn: [LineageTag]

	partition _INFO_MEASURES = calculated
		mode: import
		source = INFO.VIEW.MEASURES()

	annotation TabularEditor_TableGroup = Other

	annotation BestPracticeAnalyzer_IgnoreRules = {"RuleIDs":["ROLE_ALL_MSFT_MISSING_TABLE_PERMISSION"]}
